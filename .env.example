# Copy to .env and fill in. .env is gitignored — never commit real keys.
# cp .env.example .env

# ---------------------------------------------------------------------------
# App (/app). Only EXPO_PUBLIC_* vars reach the bundle, and they ARE readable
# by anyone with the binary. Never put a service role key or the Nessie key here.
# ---------------------------------------------------------------------------

# fixtures = read /contracts/fixtures (default, works with no backend)
# api      = call the FastAPI engine
EXPO_PUBLIC_DATA_SOURCE=fixtures
EXPO_PUBLIC_ENGINE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Account preselected on every screen during the demo.
EXPO_PUBLIC_DEMO_ACCOUNT_ID=acc_checking_0001

# Prefill the sign-in form during the demo. Leave empty and the shortcut buttons
# disappear. These reach the bundle like every EXPO_PUBLIC_* var, so only ever
# put the throwaway demo account here — never a real one.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
# Seeds the 6-digit device PIN on first sign-in. The real PIN the user confirms
# is stored in the device keychain, never here.
EXPO_PUBLIC_DEMO_PIN=
# The app blocks screenshots and screen recording. Set to 1 only to record the
# demo video; leave empty everywhere else.
EXPO_PUBLIC_ALLOW_SCREEN_CAPTURE=

# ---------------------------------------------------------------------------
# Engine (/engine). Server-side only.
# ---------------------------------------------------------------------------

# Nessie is plain HTTP, so only the engine is allowed to call it.
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENGINE_PORT=8000
# Comma-separated, or * while developing.
ENGINE_CORS_ORIGINS=*
# Transfers move real money and therefore need a customer whose accounts came
# from Nessie (`cus_nessie_*`). Point this at the fixture customer and every
# transfer is refused: its nessie_account_id is a placeholder, not a real
# account. Set it to the synced customer before demoing transfers or splits.
#
# Which customers.id /customers/me serves. Leave empty to auto-pick: the
# Nessie-synced customer if there's exactly one, else the fixture customer.
# Set this once more than one customer exists in the DB (e.g. after running
# /sync/nessie against a seeded Supabase project) so /customers/me doesn't
# refuse to guess.
ACTIVE_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# DB (/db). Direct Postgres connection for migrations and the seeder.
# ---------------------------------------------------------------------------

SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# Builds (optional, only whoever runs EAS needs it)
# ---------------------------------------------------------------------------

EXPO_TOKEN=
