{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@contracts/*": [
        "../contracts/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../contracts/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "src/format.check.ts"
  ]
}
